{
  "name": "degino-site",
  "private": true,
  "description": "Degino Inc. corporate site (Zola) deployed to Cloudflare Workers",
  "scripts": {
    "build": "bash scripts/zola.sh build",
    "serve": "bash scripts/zola.sh serve --port 1111",
    "draft": "bash scripts/zola.sh serve --drafts --port 1111",
    "check": "bash scripts/zola.sh check",
    "clean": "rm -rf public",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.123.0"
  },
  "allowScripts": {
    "workerd@1.20260811.1": true
  }
}
